<Window x:Class="AlphabetForKids.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обучение — 1 Класс" Height="700" Width="980"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Window.Resources>
        <Style x:Key="AnimatedLetterButton" TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#EBF3FA"/>
            <Setter Property="Foreground" Value="#2980B9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <!-- ЭКРАН 1: Приветствие -->
        <Border x:Name="WelcomeScreen" Background="White" CornerRadius="20" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Gray" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <!-- БУКВА А -->
                <Viewbox Width="130" Height="140">
                    <Canvas Width="100" Height="100">
                        <Path Data="M 15 90 L 50 10 L 85 90 M 30 60 L 70 60" Stroke="#FF3B30" StrokeThickness="12" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="38" Canvas.Top="35" Width="8" Height="12" Fill="Black"/>
                        <Ellipse Canvas.Left="40" Canvas.Top="37" Width="3" Height="4" Fill="White"/>
                        <Ellipse Canvas.Left="54" Canvas.Top="35" Width="8" Height="12" Fill="Black"/>
                        <Ellipse Canvas.Left="56" Canvas.Top="37" Width="3" Height="4" Fill="White"/>
                        <Path Data="M 43 50 Q 50 56 57 50" Stroke="Black" StrokeThickness="2" Fill="Transparent"/>
                        <Line X1="70" Y1="60" X2="95" Y2="35" Stroke="#8E44AD" StrokeThickness="4"/>
                        <Ellipse Canvas.Left="92" Canvas.Top="32" Width="6" Height="6" Fill="#F1C40F"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Text="Привет! Я буква А!" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                <TextBlock Text="Как тебя зовут, мой юный друг?" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBox x:Name="TxtName" FontSize="18" Padding="8" Width="300" HorizontalContentAlignment="Center" Margin="0,0,0,20"/>
                <Button Content="Далее" Click="StartApp_Click" Style="{StaticResource ActionButton}" Background="#2ECC71"/>
            </StackPanel>
        </Border>

        <!-- Выбор предмета -->
        <Border x:Name="SubjectSelectionScreen" Background="White" CornerRadius="20" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" Width="550" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Gray" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtSubjectGreeting" Text="Что будем изучать?" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,25" TextWrapping="Wrap" TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="🔤 Азбука и Письмо" Click="SelectAlphabet_Click" Style="{StaticResource ActionButton}" Background="#3498DB" Width="210" Height="80" Margin="10" FontSize="18"/>
                    <Button Content="🔢 Математика" Click="SelectMath_Click" Style="{StaticResource ActionButton}" Background="#9B59B6" Width="210" Height="80" Margin="10" FontSize="18"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Главный учебный интерфейс -->
        <Grid x:Name="MainAppScreen" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="White" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- БУКВА А (МАЛЕНЬКИЙ) -->
                    <Viewbox Width="50" Height="50" Grid.Column="0">
                        <Canvas Width="100" Height="100">
                            <Path Data="M 15 90 L 50 10 L 85 90 M 30 60 L 70 60" Stroke="#FF3B30" StrokeThickness="12" StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="38" Canvas.Top="35" Width="8" Height="12" Fill="Black"/>
                            <Ellipse Canvas.Left="54" Canvas.Top="35" Width="8" Height="12" Fill="Black"/>
                            <Path Data="M 43 50 Q 50 56 57 50" Stroke="Black" StrokeThickness="2" Fill="Transparent"/>
                            <Line X1="70" Y1="60" X2="95" Y2="35" Stroke="#8E44AD" StrokeThickness="4"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock x:Name="TxtGreeting" Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#34495E" Margin="10,0,10,0" TextWrapping="Wrap"/>

                    <!-- Ползунок громкости -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                        <TextBlock Text="🔊" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.2" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- Кнопка возврата к выбору предмета -->
                    <Button Grid.Column="3" Content="← Сменить предмет" Click="BackToSubjectSelection_Click" Style="{StaticResource ActionButton}" Background="#E67E22" FontSize="14" Padding="10,6"/>
                </Grid>
            </Border>

            <!-- Модуль: Азбука -->
            <Grid x:Name="AlphabetContainer" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Выбери букву:" FontSize="16" FontWeight="Bold" Margin="5,0,5,10" Foreground="#2C3E50"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="AlphabetPanel" ItemWidth="65" ItemHeight="65"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtSelectedTitle" Text="Буква А" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>

                        <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="12" Margin="0,15" Background="#FAF9F6">
                            <Grid>
                                <Canvas>
                                    <Line X1="0" Y1="100" X2="1000" Y2="100" Stroke="#E2E8F0" StrokeThickness="2"/>
                                    <Line X1="0" Y1="240" X2="1000" Y2="240" Stroke="#E2E8F0" StrokeThickness="2"/>
                                    <Line X1="0" Y1="170" X2="1000" Y2="170" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeDashArray="4 4"/>
                                </Canvas>

                                <TextBlock x:Name="TxtTemplate" Text="А а" FontSize="130" FontFamily="Segoe Script, Comic Sans MS" 
                                           Foreground="#CBD5E1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock x:Name="TxtAnimated" Text="А а" FontSize="130" FontFamily="Segoe Script, Comic Sans MS" 
                                           Foreground="#E74C3C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Clip>
                                        <RectangleGeometry x:Name="WritingClip" Rect="0,0,0,500"/>
                                    </TextBlock.Clip>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Модуль: Математика -->
            <Grid x:Name="MathContainer" Grid.Row="1" Visibility="Collapsed">
                <Border Background="White" CornerRadius="15" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Реши пример:" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                            <TextBlock x:Name="TxtMathProblem" Text="5 + 3 = " FontSize="48" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMathAnswer" FontSize="40" FontWeight="Bold" Width="100" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="5"/>
                        </StackPanel>

                        <Button Content="Проверить ответ" Click="CheckMathAnswer_Click" Style="{StaticResource ActionButton}" Background="#2ECC71" Margin="0,0,0,20" Width="220"/>

                        <TextBlock x:Name="TxtMathResult" Text="" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>